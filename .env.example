# Copy to .env (or point at another file with --env-file).
# Precedence: command line flags > real environment variables > this file > built-in defaults.
# Relative paths are relative to the directory you start the emulator from.

KUBE_EMULATOR_PORT=8085
KUBE_EMULATOR_BIND_ADDRESS=127.0.0.1

# memory | sqlite
KUBE_EMULATOR_STORAGE=memory
KUBE_EMULATOR_SQLITE_PATH=./kube-emulator.db

# Load custom kinds from CRD files in this folder (re-scanned every KINDS_RELOAD; 0 = once)
#KUBE_EMULATOR_KINDS_DIR=./examples/kinds
#KUBE_EMULATOR_KINDS_RELOAD=2s

# Schemas for `kubectl explain` on built-in kinds (OpenAPI v2 swagger.json)
#KUBE_EMULATOR_OPENAPI_SPEC=./swagger.json

# Fake nodes: emulator-node-1..N (spread over zone-a/b/c) with this capacity
KUBE_EMULATOR_NODES=1
KUBE_EMULATOR_NODE_CPU=8
KUBE_EMULATOR_NODE_MEMORY=16Gi
KUBE_EMULATOR_NODE_PODS=110

# Pod lifecycle delays: schedule, pull, start, ready, job, terminate, backoff (or "instant")
#KUBE_EMULATOR_DELAYS=pull=3s,ready=5s

# Manifests (nodes, namespaces, workloads, ...) created at start-up when missing
#KUBE_EMULATOR_SEED_DIR=./examples/scheduling

# Also write a kubeconfig pointing at this server
#KUBE_EMULATOR_WRITE_KUBECONFIG=./emulator.kubeconfig

# Dump every request (full headers and body)
KUBE_EMULATOR_VERBOSE=false
